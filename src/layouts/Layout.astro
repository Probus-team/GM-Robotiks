---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../data/site';
import { canonicalPath } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>[];
}

const { title = `${site.name} · ${site.tagline}`, description = site.description, structuredData = [] } = Astro.props;
if (!Astro.site) throw new Error('A canonical site URL is required for page metadata.');
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const home = new URL('/', Astro.site).href;
const socialImage = new URL('/og-default.png', Astro.site).href;
const organizationId = `${home}#organization`;
const graph = [
  {
    '@type': 'Organization', '@id': organizationId,
    name: site.name, alternateName: ['GM Robotics IA', site.shortName],
    url: home, description: site.description,
    logo: new URL('/brand/logo-full.png', Astro.site).href,
    email: site.contact.email,
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales',
      telephone: `+${site.contact.whatsapp}`, email: site.contact.email,
      areaServed: 'MX', availableLanguage: 'Spanish' },
  },
  { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: site.name,
    alternateName: 'GM Robotiks', inLanguage: 'es-MX', publisher: { '@id': organizationId } },
  { '@type': Astro.url.pathname.startsWith('/robots') ? 'CollectionPage' : 'WebPage',
    '@id': `${canonical}#webpage`, url: canonical, name: title, description,
    inLanguage: 'es-MX', isPartOf: { '@id': `${home}#website` }, about: { '@id': organizationId } },
  ...structuredData,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#123559" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64 128x128 256x256" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — robots de servicio Pudu en México`} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${site.name} — robots de servicio Pudu en México`} />
    <script type="application/ld+json" set:html={jsonLd} />

    <Font cssVariable="--font-display" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin', style: 'normal' }]} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Scroll reveal. Containers with [data-stagger] number their children so
      // each one waits a little longer than the previous (see global.css).
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        Array.from(group.children).forEach((child, i) => (child as HTMLElement).style.setProperty('--i', String(i)));
      });

      const items = document.querySelectorAll<HTMLElement>('.reveal, .reveal-clip, .reveal-lines');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
