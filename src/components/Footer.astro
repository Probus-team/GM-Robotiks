---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="brand">
      <img src="/brand/logo-mark-white.png" alt="" width="920" height="453" />
      <p>{site.tagline}. Distribuidor e integrador de Pudu Robotics.</p>
    </div>
    <nav aria-label="Pie de página">
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </nav>
    <p class="legal">
      © {year} {site.name}. Pudu, BellaBot, KettyBot, PuduBot y FlashBot son marcas de Pudu Robotics.
      Las especificaciones son del fabricante y pueden cambiar sin previo aviso.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--burgundy-ink);
    color: var(--on-dark-muted);
    padding-block: 3.5rem 2.5rem;
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem 4rem;
    align-items: start;
  }

  .brand {
    display: grid;
    gap: 1rem;
    max-width: 24rem;
  }

  .brand img {
    width: 5.5rem;
    height: auto;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  nav a {
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }

  nav a:hover {
    color: var(--coral-hot);
  }

  .legal {
    grid-column: 1 / -1;
    font-size: 0.82rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
