---
import { site } from '../data/site';
import { families } from '../data/robots';
import BrandImage from './BrandImage.astro';
import { legalPages } from '../data/legal';
const year = new Date().getFullYear();
const { email, whatsapp } = site.contact;
---

<footer class="footer on-dark">
  <div class="container inner">
    <div class="brand">
      <BrandImage variant="white" loading="lazy" />
      <p>{site.tagline}. Distribuidor e integrador de Pudu Robotics.</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="col-title">Sitio</p>
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href={site.cta.href}>{site.cta.label}</a></li>
      </ul>
    </nav>
    <nav aria-label="Líneas de robots">
      <p class="col-title">Robots</p>
      <ul>
        {families.map((f) => (
          <li><a href={`/robots/#${f.id}`}>{f.name}</a></li>
        ))}
      </ul>
    </nav>
    <div class="reach">
      <p class="col-title">Contacto</p>
      <ul>
        {whatsapp && <li><a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></li>}
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        <li>México</li>
      </ul>
    </div>
    <nav class="legal-links" aria-label="Legal">
      {legalPages.map((p) => <a href={p.path}>{p.label}</a>)}
    </nav>
    <p class="legal">
      © {year} {site.name}. Pudu, BellaBot, KettyBot, PuduBot y FlashBot son marcas de Pudu Robotics. Las
      especificaciones, fotos y videos de los robots son del fabricante y pueden cambiar sin previo aviso.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--on-dark-muted);
    padding-block: 4rem 2.5rem;
    margin-top: var(--bezel);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem 3rem;
    align-items: start;
  }

  .brand {
    display: grid;
    gap: 1rem;
    max-width: 22rem;
  }

  .brand :global(img) {
    width: 10rem;
    height: auto;
  }

  .col-title {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 0.9rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  a {
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }

  a:hover {
    color: var(--sky);
  }

  .legal-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.85rem;
  }

  .legal-links + .legal {
    border-top: 0;
    padding-top: 0;
  }

  .legal {
    grid-column: 1 / -1;
    font-size: 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
  }

  @media (max-width: 56rem) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
