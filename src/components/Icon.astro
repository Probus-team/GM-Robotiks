---
// Small inline icons. Decorative: the text next to them carries the meaning.
interface Props {
  name: 'arrow' | 'whatsapp' | 'pause' | 'play' | 'download' | 'arrow-down';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['icon', name === 'arrow' && 'arrow', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'arrow-down' && <path d="M12 4v15m-6-6 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'download' && <path d="M12 3v12m-5-5 5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'pause' && <path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />}
  {name === 'play' && <path d="M8 5.5v13a.8.8 0 0 0 1.2.7l10.4-6.5a.8.8 0 0 0 0-1.4L9.2 4.8A.8.8 0 0 0 8 5.5Z" fill="currentColor" />}
  {name === 'whatsapp' && (
    <path
      fill="currentColor"
      d="M12 2a9.9 9.9 0 0 0-8.6 14.8L2 22l5.3-1.4A9.9 9.9 0 1 0 12 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"
    />
  )}
</svg>

<style>
  .icon {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }
</style>
