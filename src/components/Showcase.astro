---
// Full-screen media, one inset frame per robot line. Panels are sticky, so
// each frame slides over the previous one as you scroll, and the covered one
// shrinks back a little; the loop under a panel only plays while it is the one
// on screen. Every clip is Pudu Robotics' footage and says so in its credit.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { panels } from '../data/showcase';
import { families, robots } from '../data/robots';
import { scene } from '../lib/media';

const withCounts = panels.map((p) => ({
  ...p,
  count: robots.filter((r) => r.family === p.family).length,
  familyName: families.find((f) => f.id === p.family)!.name,
}));
---

<section class="showcase on-dark" id="lineas" aria-label="Robots en acción, por línea" data-showcase>
  <ol class="rail" aria-hidden="true" data-rail>
    {withCounts.map((p) => (
      <li data-rail-item={p.family}><span class="rail-bar"></span><span class="rail-label">{p.familyName}</span></li>
    ))}
  </ol>

  {withCounts.map((p, i) => (
    <article class="panel" data-panel={p.family} style={`--n:${i}`} aria-labelledby={`panel-${p.family}`}>
      <div class="frame panel-frame">
        <div class="media">
          {p.media.type === 'video' ? (
            <video
              data-src={p.media.src}
              data-src-av1={p.media.av1}
              data-poster={p.media.poster}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              data-loop
            ></video>
          ) : (
            <Picture
              src={scene(p.media.scene)}
              alt=""
              widths={[640, 960, 1280, 1600, 2000, 2560, 2880]}
              sizes="100vw"
              formats={['avif']} fallbackFormat="webp"
              class="still"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
        <div class="scrim" aria-hidden="true"></div>

        <div class="container content">
          <p class="kicker"><span class="fam">{p.kicker}</span><span class="sep"></span><span class="count">{p.count} modelos</span></p>
          <h2 id={`panel-${p.family}`}>{p.title}</h2>
          <p class="detail">{p.detail}</p>
          <div class="foot">
            <a href={`/robots/#${p.family}`} class="btn btn-white">Ver los {p.count} modelos <Icon name="arrow" /></a>
            <a class="figure" href={`/robots/${p.figureRobot}/`}><b>{p.figure}</b><span>{p.figureLabel}</span></a>
          </div>
        </div>
        <p class="credit">{p.credit}</p>
      </div>
    </article>
  ))}
</section>

<style>
  .showcase {
    position: relative;
    overflow: clip; /* keeps the rail inside the section; clip (unlike hidden) leaves sticky intact */
    color: var(--white);
    background: var(--white);
  }

  .panel {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding: var(--bezel);
    display: grid;
    /* --cover: how much the next panel already covers this one (0–1), set by script */
    --cover: 0;
  }

  .panel-frame {
    display: grid;
    align-items: end;
    height: 100%;
    margin: 0;
    transform: scale(calc(1 - var(--cover) * 0.06));
    transform-origin: 50% 0%;
    filter: brightness(calc(1 - var(--cover) * 0.55));
    transition:
      transform 0.1s linear,
      filter 0.1s linear;
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .media video,
  .media :global(.still) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stills get a slow drift so the panel is never fully static. */
  .panel.is-active :global(.still) {
    animation: kenburns 18s ease-in-out infinite alternate;
  }

  @keyframes kenburns {
    from {
      transform: scale(1) translateX(0);
    }
    to {
      transform: scale(1.08) translateX(-2%);
    }
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(10, 28, 43, 0.3) 0%, transparent 28%, transparent 50%, rgba(10, 28, 43, 0.88) 100%),
      linear-gradient(90deg, rgba(10, 28, 43, 0.6) 0%, transparent 62%);
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    padding-bottom: clamp(3.5rem, 9vh, 6.5rem);
  }

  .content > * {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .content > :nth-child(1) { transition-delay: 0.05s; }
  .content > :nth-child(2) { transition-delay: 0.15s; }
  .content > :nth-child(3) { transition-delay: 0.25s; }
  .content > :nth-child(4) { transition-delay: 0.35s; }

  .panel.is-active .content > * {
    opacity: 1;
    transform: none;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kicker .fam {
    color: var(--sky);
  }

  .kicker .sep {
    width: 2rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
  }

  .kicker .count {
    color: var(--on-dark-muted);
  }

  h2 {
    font-size: clamp(2.2rem, 5.2vw, 4.8rem);
    max-width: 12em;
    text-shadow: 0 2px 30px rgba(10, 28, 43, 0.5);
  }

  .detail {
    font-size: var(--fs-lede);
    color: rgba(226, 238, 248, 0.9);
    max-width: 32em;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 0.5rem;
  }

  .figure {
    display: grid;
    line-height: 1.1;
    text-decoration: none;
    padding-left: 1.25rem;
    border-left: 1px solid rgba(255, 255, 255, 0.28);
  }

  .figure b {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.8vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .figure span {
    font-size: var(--fs-label);
    color: var(--on-dark-muted);
  }

  .figure:hover span {
    text-decoration: underline;
  }

  .credit {
    position: absolute;
    z-index: 2;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 1.75rem);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.66);
  }

  /* Progress rail */
  .rail {
    position: sticky;
    top: 50%;
    z-index: 10;
    height: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: none;
    gap: 0.75rem;
    transform: translateY(-50%);
    width: max-content;
    margin-left: auto;
    margin-right: calc(var(--bezel) + var(--gutter));
    transition: opacity 0.4s;
  }

  .rail.is-off {
    opacity: 0;
  }

  .rail li {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.55rem;
    border-radius: 0.5rem;
    /* A dark chip keeps the label legible over light footage (sky, white walls). */
    background: rgba(10, 28, 43, 0.72);
    color: rgba(255, 255, 255, 0.82);
    transition: color 0.3s;
  }

  .rail-bar {
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition:
      width 0.4s var(--ease-out),
      background-color 0.3s;
  }

  .rail li.is-current {
    color: var(--white);
  }

  .rail li.is-current .rail-bar {
    width: 2.5rem;
    background: var(--sky);
  }

  @media (min-width: 64rem) {
    .rail {
      display: grid;
    }
  }

  @media (max-width: 40rem) {
    .scrim {
      background:
        linear-gradient(0deg, rgba(10, 28, 43, 0.94) 0%, rgba(10, 28, 43, 0.6) 50%, rgba(10, 28, 43, 0.1) 78%),
        linear-gradient(180deg, rgba(10, 28, 43, 0.35) 0%, transparent 20%);
    }

    .credit {
      left: var(--gutter);
      right: auto;
      bottom: 1rem;
    }

    .content {
      padding-bottom: 3.5rem;
    }

    .figure {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-frame {
      transform: none;
      filter: none;
    }

    .panel.is-active :global(.still) {
      animation: none;
    }

    .content > * {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  const panels = Array.from(root?.querySelectorAll<HTMLElement>('[data-panel]') ?? []);
  const videos = panels.map((panel) => panel.querySelector<HTMLVideoElement>('[data-loop]'));
  const railItems = Array.from(root?.querySelectorAll<HTMLElement>('[data-rail-item]') ?? []);
  const rail = root?.querySelector<HTMLElement>('[data-rail]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // AV1 where the browser decodes it (Safari only with hardware support), H.264 otherwise.
  const loadVideo = (video: HTMLVideoElement) => {
    if (!video.dataset.src) return;
    const av1 = video.dataset.srcAv1 && video.canPlayType?.('video/mp4; codecs="av01.0.08M.10"');
    video.src = av1 ? video.dataset.srcAv1! : video.dataset.src;
    delete video.dataset.src;
    video.preload = 'auto';
    video.load();
  };

  const showPoster = (video: HTMLVideoElement) => {
    if (!video.dataset.poster) return;
    video.poster = video.dataset.poster;
    delete video.dataset.poster;
  };

  // Posters and loops wait until the page has loaded, so they never compete with
  // the hero poster; after that, only panels within 600px are fetched. Reduced
  // motion gets the posters and never the loops.
  const warm = () => {
    const preloadObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const video = entry.target as HTMLVideoElement;
        showPoster(video);
        if (!reduce) loadVideo(video);
        preloadObserver.unobserve(video);
      }
    }, { rootMargin: '600px 0px' });
    videos.forEach((video) => { if (video) preloadObserver.observe(video); });
  };
  if (document.readyState === 'complete') warm();
  else window.addEventListener('load', warm, { once: true });

  let raf = 0;
  let current = -1;
  const covers: string[] = [];
  const update = () => {
    raf = 0;
    const vh = window.innerHeight;
    // Read all geometry before changing styles to avoid repeated forced layout.
    const bounds = panels.map((panel) => panel.getBoundingClientRect());
    let active = -1;
    bounds.forEach((rect, i) => {
      if ((Math.min(rect.bottom, vh) - Math.max(rect.top, 0)) / rect.height >= 0.55) active = i;
    });

    if (!reduce) {
      for (let i = 0; i < panels.length - 1; i++) {
        const cover = Math.min(1, Math.max(0, 1 - bounds[i + 1].top / vh)).toFixed(3);
        if (covers[i] !== cover) {
          panels[i].style.setProperty('--cover', cover);
          covers[i] = cover;
        }
      }
    }

    if (active !== current) {
      current = active;
      if (active >= 0) {
        panels[active].classList.add('is-active');
        const id = panels[active].dataset.panel;
        railItems.forEach((item) => item.classList.toggle('is-current', item.dataset.railItem === id));
        rail?.classList.toggle('is-off', id === 'all');
      }
    }
    videos.forEach((video, i) => {
      if (!video) return;
      const exposedBottom = Math.min(bounds[i].bottom, bounds[i + 1]?.top ?? vh, vh);
      const visible = exposedBottom > Math.max(bounds[i].top, 0);
      if (visible) showPoster(video);
      if (visible && panels[i].classList.contains('is-active') && !reduce && !document.hidden) {
        loadVideo(video);
        if (video.paused) video.play().catch(() => {});
      } else if (!video.paused) {
        // Sticky panels stay geometrically visible even when the next panel covers them.
        video.pause();
      }
    });
  };
  const scheduleUpdate = () => {
    if (!raf) raf = requestAnimationFrame(update);
  };
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', scheduleUpdate);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) videos.forEach((video) => video?.pause());
    else scheduleUpdate();
  });
  update();
</script>
