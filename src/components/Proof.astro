---
// Proof, kept truthful. Mexican deployments render from src/data/deployments.ts.
// Until there is one, marked slots show on preview and local hosts only, so the
// team can see where the content goes; production hides them (script below).
// The footage below is Pudu Robotics', labelled by where it was shot.
import { Picture } from 'astro:assets';
import { cases, robots } from '../data/robots';
import { deployments, slotChecklist } from '../data/deployments';

const featured = cases.filter((c) => c.featured);
const rest = cases.filter((c) => !c.featured);
const robotName = (id: string) => robots.find((r) => r.id === id)?.name.replace('PUDU ', '') ?? id;
const pendingSlots = deployments.length === 0 ? 3 : 0;
---

<section class="section proof" id="casos" aria-labelledby="proof-title">
  <div class="container">
    <div class="section-head" data-stagger>
      <p class="eyebrow reveal">En operación</p>
      <h2 id="proof-title" class="reveal">Así se ven en turno.</h2>
      <p class="lede reveal">
        {deployments.length > 0
          ? 'Robots que ya trabajan con nuestros clientes en México, y video de Pudu Robotics de otros despliegues.'
          : 'Video de Pudu Robotics: tres grabados en plantas y laboratorios de sus clientes, tres de presentación de producto. Los despliegues en México se publican aquí con permiso de cada cliente.'}
      </p>
    </div>

    {deployments.length > 0 && (
      <ul class="deployments" data-stagger>
        {deployments.map((d) => (
          <li class="deployment reveal">
            <figure>
              <Picture src={d.photo} alt={d.photoAlt} widths={[480, 720, 960, 1280]} sizes="(max-width: 56rem) 100vw, 33vw" formats={['avif']} fallbackFormat="webp" loading="lazy" />
              <figcaption>
                <span class="where">{d.sector} · {d.city}</span>
                <strong>{d.client}</strong>
                <span class="robots">{d.robots.map(robotName).join(' · ')} · desde {d.since}</span>
                {d.metric && <span class="metric"><b>{d.metric.value}</b> {d.metric.label}</span>}
                {d.quote && <blockquote>“{d.quote.text}” <cite>{d.quote.person}, {d.quote.role}</cite></blockquote>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    {pendingSlots > 0 && (
      <div class="slots" data-pending-slots hidden>
        <p class="slots-note">
          Vista previa: estos espacios no aparecen en gmrobotiks.com hasta que haya un caso real en{' '}
          <code>src/data/deployments.ts</code>.
        </p>
        <ul>
          {Array.from({ length: pendingSlots }, (_, i) => (
            <li class="slot">
              <span class="slot-tag">Caso en México {i + 1} · pendiente</span>
              <ul class="slot-list">
                {slotChecklist.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="grid" data-stagger>
      {[...featured, ...rest].map((c) => (
        <figure class:list={['clip reveal', { featured: c.featured }]}>
          <div class="frame-video">
            <video src={c.src} data-poster={c.poster} preload="none" controls playsinline aria-label={`${c.title}. ${c.where}.`}></video>
            <span class:list={['kind', c.kind]}>{c.kind === 'deployment' ? 'En sitio del cliente' : 'Video de producto'}</span>
            <span class="time">{c.minutes}</span>
          </div>
          <figcaption>
            <span class="where">{c.where}</span>
            <strong>{c.title}</strong>
            <span class="robots">{c.robots.join(' · ')} · video de Pudu Robotics</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .proof {
    background: var(--white);
  }

  h2 {
    color: var(--navy);
  }

  .deployments {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
  }

  .deployment figure {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .deployment :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .metric b {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--navy);
  }

  blockquote {
    margin: 0.5rem 0 0;
    color: var(--text);
  }

  cite {
    display: block;
    font-style: normal;
    color: var(--muted);
    font-size: var(--fs-small);
  }

  /* Pending slots: deliberately look like placeholders. */
  .slots {
    margin-bottom: 3rem;
  }

  .slots[hidden] {
    display: none;
  }

  .slots-note {
    font-size: var(--fs-small);
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .slots > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
  }

  .slot {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: 15rem;
    padding: 1.25rem;
    border: 2px dashed var(--line-strong);
    border-radius: var(--radius);
    background: repeating-linear-gradient(-45deg, var(--ice), var(--ice) 12px, var(--white) 12px, var(--white) 24px);
  }

  .slot-tag {
    justify-self: start;
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    background: var(--navy);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .slot-list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
    font-size: var(--fs-small);
    color: var(--text);
  }

  /* Footage */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem 1.25rem;
  }

  .clip {
    margin: 0;
    grid-column: span 4;
    display: grid;
    gap: 0.85rem;
    align-content: start;
    min-width: 0;
  }

  .clip.featured {
    grid-column: span 6;
  }

  .frame-video {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink);
    aspect-ratio: 16 / 9;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kind,
  .time {
    position: absolute;
    top: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: 0.45rem;
    background: rgba(10, 28, 43, 0.78);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 700;
    pointer-events: none;
  }

  .kind {
    left: 0.75rem;
  }

  .kind.deployment {
    background: var(--white);
    color: var(--navy);
  }

  .time {
    right: 0.75rem;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
  }

  .where {
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--blue);
  }

  figcaption strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--navy);
  }

  .robots {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 64rem) {
    .clip,
    .clip.featured {
      grid-column: span 6;
    }
  }

  @media (max-width: 40rem) {
    .clip,
    .clip.featured {
      grid-column: span 12;
    }
  }
</style>

<script>
  // Pending slots are for reviewers: show them on preview and local hosts only.
  const slots = document.querySelector<HTMLElement>('[data-pending-slots]');
  const production = ['gmrobotiks.com', 'www.gmrobotiks.com'].includes(location.hostname);
  if (slots && !production) slots.hidden = false;

  // Posters load as the section approaches, not with the page.
  const videos = document.querySelectorAll<HTMLVideoElement>('#casos video');
  const showPoster = (video: HTMLVideoElement) => {
    if (video.dataset.poster) video.poster = video.dataset.poster;
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        showPoster(entry.target as HTMLVideoElement);
        io.unobserve(entry.target);
      });
    }, { rootMargin: '600px 0px' });
    videos.forEach((video) => io.observe(video));
  } else {
    videos.forEach(showPoster);
  }

  // Only one clip plays at a time.
  videos.forEach((v) =>
    v.addEventListener('play', () => {
      videos.forEach((other) => {
        if (other !== v) other.pause();
      });
    }),
  );
</script>
