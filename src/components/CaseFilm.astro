---
// A case film with controls. Browsers take the first source they can play:
// AV1 (Chrome, Firefox, Edge, newer Safari), HEVC (other Safari), then the
// small local H.264 copy. The poster is set by the page's script when the
// film comes near, so data-poster is passed through with the other attributes.
import type { CaseVideo } from '../data/robots';

interface Props {
  clip: CaseVideo;
  [attribute: string]: unknown;
}

const { clip, ...attributes } = Astro.props;
---

<video data-poster={clip.poster} preload="none" controls playsinline aria-label={`${clip.title}. ${clip.where}.`} {...attributes}>
  <source src={clip.av1} type='video/mp4; codecs="av01.0.08M.10"' />
  <source src={clip.hevc} type='video/mp4; codecs="hvc1.1.6.L120.90"' />
  <source src={clip.src} type="video/mp4" />
</video>
