---
import { cases } from '../data/robots';
const featured = cases.filter((c) => c.featured);
const rest = cases.filter((c) => !c.featured);
---

<section class="section cases" id="casos">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">En operación</p>
      <h2>Así se ven en turno, no en render.</h2>
      <p>
        Material de despliegues reales y presentaciones oficiales de Pudu. Sin locución nuestra: lo que
        importa es cómo se mueve el robot entre gente, montacargas y estantes.
      </p>
    </div>

    <div class="grid">
      {[...featured, ...rest].map((c, i) => (
        <figure class:list={['clip reveal', { featured: c.featured }]} style={`--i:${i}`}>
          <div class="frame">
            <video
              src={c.src}
              poster={c.poster}
              preload="none"
              controls
              playsinline
              aria-label={c.title}
            ></video>
            <span class="time">{c.minutes}</span>
          </div>
          <figcaption>
            <span class="where">{c.where}</span>
            <strong>{c.title}</strong>
            <span class="robots">{c.robots.join(' · ')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .cases {
    background: var(--rose);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
  }

  .clip {
    margin: 0;
    grid-column: span 3;
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .clip.featured {
    grid-column: span 6;
  }

  .frame {
    position: relative;
    min-width: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--burgundy-ink);
    aspect-ratio: 16 / 9;
    box-shadow: 0 30px 50px -30px rgba(43, 8, 16, 0.5);
  }

  video {
    min-width: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .time {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgba(43, 8, 16, 0.7);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    pointer-events: none;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    padding-inline: 0.25rem;
  }

  .where {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
  }

  figcaption strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .robots {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 64rem) {
    .clip,
    .clip.featured {
      grid-column: span 6;
    }
  }

  @media (max-width: 40rem) {
    .clip,
    .clip.featured {
      grid-column: span 12;
    }
  }
</style>

<script>
  // Only one clip plays at a time.
  const videos = document.querySelectorAll<HTMLVideoElement>('#casos video');
  videos.forEach((v) =>
    v.addEventListener('play', () => {
      videos.forEach((other) => {
        if (other !== v) other.pause();
      });
    }),
  );
</script>
