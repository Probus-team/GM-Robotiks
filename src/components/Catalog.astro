---
// The catalog, one section per robot line. Each line opens with its newest
// (or first) robot shown in context; the rest stand on a light stage. Every
// tile links to the robot's page and has its own WhatsApp quote.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { families, robots } from '../data/robots';
import { robotCutout, robotScene, scene } from '../lib/media';
import { robotQuoteUrl } from '../lib/whatsapp';
import { site } from '../data/site';
import { robotPath } from '../data/seo';

const lines = families.map((family) => {
  const list = robots.filter((r) => r.family === family.id);
  const lead = list.find((r) => r.isNew && robotScene(r.id)) ?? list.find((r) => robotScene(r.id)) ?? list[0];
  return { ...family, lead, rest: list.filter((r) => r !== lead), count: list.length };
});
const pageUrl = (id: string) => new URL(robotPath(id), Astro.site).href;
---

<section class="catalog-hero" aria-labelledby="catalog-title">
  <div class="frame on-dark hero-frame">
    <Picture
      src={scene('pudu-family')}
      alt=""
      widths={[640, 960, 1280, 1800]}
      sizes="100vw"
      formats={['avif']}
      fallbackFormat="webp"
      class="bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim" aria-hidden="true"></div>
    <div class="container content">
      <p class="eyebrow">Catálogo Pudu · {robots.length} modelos</p>
      <h1 id="catalog-title">Un robot para cada piso, pasillo y jardín.</h1>
      <p class="lede">
        Todos son de Pudu Robotics, con refacciones y soporte de GM Robotiks IA en México. Los datos son los del
        fabricante; en el piloto los medimos en tu sitio.
      </p>
      <nav class="jump" aria-label="Ir a una línea">
        {lines.map((line) => (
          <a href={`#${line.id}`}>{line.name} <span>{line.count}</span></a>
        ))}
      </nav>
    </div>
  </div>
</section>

{lines.map((line) => (
  <section class="section line" id={line.id} aria-labelledby={`${line.id}-title`}>
    <div class="container layout">
      <header class="line-head">
        <p class="eyebrow">{line.count} modelos</p>
        <h2 id={`${line.id}-title`}>{line.name}</h2>
        <p class="short">{line.short}.</p>
        <p class="where">{line.where}</p>
      </header>

      <ul class="tiles" data-stagger>
        <li class="tile lead reveal">
          <div class="media">
            <Picture
              src={robotScene(line.lead.id) ?? robotCutout(line.lead.id)}
              alt=""
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 56rem) 100vw, 60vw"
              formats={['avif']}
              fallbackFormat="webp"
              loading="lazy"
              class:list={[robotScene(line.lead.id) ? 'scene' : 'cutout']}
            />
            {line.lead.isNew && <span class="tag">Nuevo 2026</span>}
          </div>
          <div class="body">
            <h3><a href={robotPath(line.lead.id)} class="stretch">{line.lead.name}</a></h3>
            <p class="role">{line.lead.role}</p>
            <p class="figure"><b>{line.lead.keyFigures[0].value}{line.lead.keyFigures[0].unit && ` ${line.lead.keyFigures[0].unit}`}</b> {line.lead.keyFigures[0].label}</p>
            <div class="actions">
              <span class="more">Ver ficha <Icon name="arrow" /></span>
              <a class="quote" href={robotQuoteUrl(site.contact.whatsapp, line.lead, pageUrl(line.lead.id))} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Cotizar
              </a>
            </div>
          </div>
        </li>
        {line.rest.map((robot) => (
          <li class="tile reveal">
            <div class="media stage">
              <Picture
                src={robotCutout(robot.id)}
                alt=""
                widths={[240, 360, 480, 640]}
                sizes="(max-width: 40rem) 80vw, 18rem"
                formats={['avif']}
                fallbackFormat="webp"
                loading="lazy"
                class="cutout"
              />
              {robot.isNew && <span class="tag">Nuevo 2026</span>}
            </div>
            <div class="body">
              <h3><a href={robotPath(robot.id)} class="stretch">{robot.name}</a></h3>
              <p class="role">{robot.role}</p>
              <p class="figure"><b>{robot.keyFigures[0].value}{robot.keyFigures[0].unit && ` ${robot.keyFigures[0].unit}`}</b> {robot.keyFigures[0].label}</p>
              <div class="actions">
                <span class="more">Ver ficha <Icon name="arrow" /></span>
                <a class="quote" href={robotQuoteUrl(site.contact.whatsapp, robot, pageUrl(robot.id))} target="_blank" rel="noopener" aria-label={`Cotizar ${robot.name} por WhatsApp`}>
                  <Icon name="whatsapp" /> Cotizar
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
))}

<style>
  .catalog-hero {
    padding-top: var(--bezel);
  }

  .hero-frame {
    display: grid;
    align-items: end;
    min-height: min(46rem, 88svh);
  }

  .hero-frame :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 60%;
    z-index: 0;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(10, 28, 43, 0.9) 0%, rgba(10, 28, 43, 0.55) 50%, rgba(10, 28, 43, 0.2) 100%),
      linear-gradient(0deg, rgba(10, 28, 43, 0.85) 0%, transparent 60%);
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: 9rem clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    font-size: clamp(2.6rem, 6vw + 0.5rem, 6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    max-width: 12em;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.95rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(10, 28, 43, 0.35);
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .jump a:hover {
    border-color: var(--white);
    background: rgba(255, 255, 255, 0.1);
  }

  .jump span {
    font-size: 0.8rem;
    color: var(--sky);
  }

  /* Lines */
  .line + .line {
    border-top: 1px solid var(--line);
  }

  .layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .line-head {
    position: sticky;
    top: calc(var(--header-h) + 2.5rem);
    display: grid;
    gap: 0.6rem;
  }

  .line-head h2 {
    color: var(--navy);
    font-size: clamp(2.2rem, 3.5vw, 3.2rem);
  }

  .short {
    font-weight: 700;
    color: var(--text);
  }

  .where {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .tile {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .tile.lead {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem 2rem;
  }

  .media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ice);
  }

  .lead .media {
    aspect-ratio: 16 / 10;
    background: var(--ink);
  }

  .lead .media :global(.scene) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.8s var(--ease-out);
  }

  .lead .media :global(.cutout) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2rem;
  }

  .tile:hover .media :global(.scene) {
    scale: 1.03;
  }

  /* Cut-outs stand on a floor line at the bottom of a light stage. */
  .stage {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: end center;
    aspect-ratio: 1 / 1;
    padding: 1.5rem 1.25rem 0;
    background:
      linear-gradient(0deg, var(--ice-2) 0 14%, transparent 14%),
      var(--ice);
  }

  .stage :global(.cutout) {
    max-height: 92%;
    max-width: 100%;
    width: auto;
    height: auto;
    margin-bottom: 8%;
    object-fit: contain;
    transition: translate 0.5s var(--ease-out);
  }

  .tile:hover .stage :global(.cutout) {
    translate: 0 -8px;
  }

  .tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.25rem 0.55rem;
    border-radius: 0.45rem;
    background: var(--navy);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .body {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  h3 {
    font-size: var(--fs-h3);
    color: var(--navy);
  }

  .lead h3 {
    font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  /* The title link covers the whole tile; the quote link sits above it. */
  .stretch {
    text-decoration: none;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }

  .stretch:focus-visible {
    outline: none;
  }

  .stretch:focus-visible::after {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  .role {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .figure {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .figure b {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--navy);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: var(--blue);
  }

  .more :global(.arrow) {
    transition: translate 0.35s var(--ease-out);
  }

  .tile:hover .more :global(.arrow) {
    translate: 0.25rem 0;
  }

  .quote {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.6rem;
    border: 1.5px solid var(--line-strong);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--navy);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .quote:hover {
    border-color: var(--navy);
  }

  @media (max-width: 64rem) {
    .layout {
      grid-template-columns: 1fr;
    }

    .line-head {
      position: static;
    }

    .tile.lead {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .content {
      padding-top: 8rem;
    }

    .tiles {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
    }

    .tile:not(.lead) .role {
      display: none;
    }

    .actions {
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .more {
      display: none;
    }

    h3 {
      font-size: 1.15rem;
    }
  }
</style>
