---
// Floating navigation bar: dark glass over every page, with one main action.
import { site } from '../data/site';
import BrandImage from './BrandImage.astro';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
---

<header class="header" data-header>
  <div class="bar">
    <a href="/" class="brand" aria-label={`${site.name}, inicio`}>
      <BrandImage variant="white" />
    </a>

    <nav class="nav" aria-label="Principal" id="nav" data-nav>
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href || (item.href === '/robots/' && current.startsWith('/robots/')) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={site.cta.href} class="btn btn-white btn-small cta">
      {site.cta.label}
      <Icon name="arrow" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" data-menu-toggle>
      <span class="sr-only">Menú</span>
      <span class="bar-line"></span>
      <span class="bar-line"></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    z-index: 60;
    top: calc(var(--bezel) + 0.65rem);
    left: 50%;
    translate: -50% 0;
    width: min(100% - 2 * (var(--bezel) + 0.65rem), 70rem);
    color: var(--white);
    --accent: var(--sky);
    view-transition-name: site-header;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
    padding: 0 0.65rem 0 1.1rem;
    border-radius: 1.1rem;
    background: rgba(10, 28, 43, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 18px 40px -24px rgba(10, 28, 43, 0.55);
    transition: background-color 0.3s;
  }

  .header.is-scrolled .bar {
    background: rgba(10, 28, 43, 0.82);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
  }

  .brand :global(img) {
    height: 2.6rem;
    width: auto;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: 0.6rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.86);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .nav a:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav a[aria-current='page'] {
    color: var(--white);
    background: rgba(255, 255, 255, 0.12);
  }

  .cta {
    margin-left: 0.5rem;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .bar-line {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% 0;
    transition: transform 0.25s var(--ease-out);
  }

  .bar-line:first-of-type {
    top: calc(50% - 4px);
  }

  .bar-line:last-of-type {
    top: calc(50% + 2px);
  }

  .menu-toggle[aria-expanded='true'] .bar-line:first-of-type {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bar-line:last-of-type {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 60rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .bar {
      gap: 0.5rem;
      padding-left: 0.85rem;
    }

    .brand :global(img) {
      height: 2.2rem;
    }

    .nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      padding: 0.5rem;
      border-radius: 1.1rem;
      background: rgba(10, 28, 43, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.14);
      opacity: 0;
      translate: 0 -6px;
      visibility: hidden;
      transition:
        opacity 0.2s,
        translate 0.25s var(--ease-out),
        visibility 0s 0.25s;
    }

    .nav.is-open {
      opacity: 1;
      translate: 0 0;
      visibility: visible;
      transition:
        opacity 0.2s,
        translate 0.25s var(--ease-out);
    }

    .nav ul {
      flex-direction: column;
    }

    .nav a {
      padding: 0.95rem 1rem;
      font-size: 1.1rem;
    }
  }

  @media (max-width: 30rem) {
    .cta {
      padding-inline: 0.85rem;
      margin-left: 0;
    }

    .cta :global(.arrow) {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  let raf = 0;
  const onScroll = () => {
    raf = 0;
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', () => {
    if (!raf) raf = requestAnimationFrame(onScroll);
  }, { passive: true });

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
