---
import { site } from '../data/site';

interface Props {
  /** Solid header from the start, for pages without a dark hero behind it. */
  solid?: boolean;
}
const { solid = false } = Astro.props;
---

<header class:list={['header', { 'is-solid': solid }]} data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name}, inicio`}>
      <img src="/brand/logo-full-white.png" alt="" width="992" height="659" class="brand-dark" />
      <img src="/brand/logo-full.png" alt="" width="992" height="659" class="brand-light" />
    </a>

    <nav class="nav" aria-label="Principal" id="nav">
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="#contacto" class="btn btn-coral header-cta">Agendar demo</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" data-menu-toggle>
        <span class="sr-only">Abrir menú</span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--white);
    background: transparent;
    view-transition-name: site-header;
    transition:
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.3s,
      transform 0.45s var(--ease-out);
  }

  .header.is-scrolled,
  .header.is-solid {
    background: rgba(255, 255, 255, 0.92);
    color: var(--text);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  /* Slides away while reading down, comes back on the first scroll up. */
  .header.is-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    height: 100%;
  }

  .brand img {
    height: 3rem;
    width: auto;
  }

  .brand-light {
    display: none;
  }

  .header.is-scrolled .brand-dark,
  .header.is-solid .brand-dark {
    display: none;
  }

  .header.is-scrolled .brand-light,
  .header.is-solid .brand-light {
    display: block;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    position: relative;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    opacity: 0.85;
    padding-block: 0.4rem;
    transition: opacity 0.2s;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    opacity: 1;
  }

  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-cta {
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 2px solid currentColor;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .menu-toggle .bar {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    transform: translateX(-50%);
    transition: transform 0.25s var(--ease-out);
  }

  .menu-toggle .bar:first-of-type {
    top: calc(50% - 4px);
  }

  .menu-toggle .bar:last-of-type {
    top: calc(50% + 2px);
  }

  .menu-toggle[aria-expanded='true'] .bar:first-of-type {
    transform: translateX(-50%) translateY(3px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bar:last-of-type {
    transform: translateX(-50%) translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 56rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .header-cta {
      display: none;
    }

    .nav {
      position: absolute;
      inset: 4.75rem 0 auto 0;
      background: var(--burgundy-ink);
      color: var(--white);
      padding: 1rem var(--gutter) 1.5rem;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 0.25s,
        transform 0.25s var(--ease-out);
    }

    .nav.is-open {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .nav ul {
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav a {
      display: block;
      padding: 0.9rem 0;
      font-size: 1.15rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      opacity: 1;
    }

    .nav a::after {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('nav');

  let last = window.scrollY;
  let raf = 0;
  const onScroll = () => {
    raf = 0;
    const y = window.scrollY;
    header?.classList.toggle('is-scrolled', y > 24);
    const menuOpen = toggle?.getAttribute('aria-expanded') === 'true' || header?.classList.contains('is-solid');
    const goingDown = y > last + 4;
    const goingUp = y < last - 4;
    if (!menuOpen && goingDown && y > 280) header?.classList.add('is-hidden');
    else if (goingUp || y <= 280) header?.classList.remove('is-hidden');
    last = y;
  };
  onScroll();
  window.addEventListener(
    'scroll',
    () => {
      if (!raf) raf = requestAnimationFrame(onScroll);
    },
    { passive: true },
  );

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    header?.classList.remove('is-hidden');
  });

  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    }),
  );
</script>
