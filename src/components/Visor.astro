---
// The robot face hidden in the GM monogram: a rounded visor with two pill
// eyes. It blinks on its own and glances toward the pointer (VisorScript.astro,
// rendered once by the page section that shows it).
interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Robot GM mirando' } = Astro.props;
---

<span class:list={['visor', className]} role="img" aria-label={label} data-visor>
  <span class="eye eye-l"><span class="pupil"></span></span>
  <span class="eye eye-r"><span class="pupil"></span></span>
</span>

<style>
  .visor {
    --w: 1em;
    display: inline-grid;
    grid-auto-flow: column;
    gap: calc(var(--w) * 0.14);
    align-items: center;
    justify-content: center;
    width: calc(var(--w) * 1.05);
    height: calc(var(--w) * 0.72);
    padding: 0 calc(var(--w) * 0.14);
    border-radius: calc(var(--w) * 0.22);
    background: var(--white);
    vertical-align: -0.08em;
    box-shadow: 0 calc(var(--w) * 0.06) calc(var(--w) * 0.25) rgba(0, 0, 0, 0.25);
  }

  .eye {
    position: relative;
    width: calc(var(--w) * 0.2);
    height: calc(var(--w) * 0.4);
    border-radius: calc(var(--w) * 0.1);
    background: var(--blue);
    overflow: hidden;
    transform-origin: center;
    animation: blink 5.2s infinite;
  }

  .eye-r {
    animation-delay: 0.02s;
  }

  .pupil {
    position: absolute;
    inset: 0;
    background: var(--navy);
    opacity: 0;
  }

  @keyframes blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eye {
      animation: none;
    }
  }
</style>
