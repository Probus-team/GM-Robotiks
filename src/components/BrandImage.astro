---
// The white full logo for dark grounds (header and footer).
import white from '../assets/brand/optimized/logo-full-white.webp';
import white320 from '../assets/brand/optimized/logo-full-white-320.webp';
import white480 from '../assets/brand/optimized/logo-full-white-480.webp';

interface Props {
  loading?: 'eager' | 'lazy';
}

const { loading = 'eager' } = Astro.props;
const sources = [white320, white480, white];
---

<img
  src={white480.src}
  srcset={sources.map((image) => `${image.src} ${image.width}w`).join(', ')}
  sizes="9.2rem"
  width={white.width}
  height={white.height}
  style={`aspect-ratio: ${white.width} / ${white.height}`}
  alt=""
  loading={loading}
  decoding="async"
/>
