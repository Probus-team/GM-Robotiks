---
// The lockup for dark grounds, as the header and footer show it. It is raster
// artwork (the approved logo has gradients), so it goes through astro:assets
// like every other image: AVIF with a WebP fallback, at the widths a 128 to
// 160 px wide logo needs on 1x, 2x and 3x screens. The lossless 320 px WebP it
// replaces was 19 kB on every page; the 1x AVIF is 3 kB.
import { Picture } from 'astro:assets';
import white from '../assets/brand/optimized/logo-full-white.webp';

interface Props {
  /** CSS width the logo is shown at. */
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { sizes, class: className, loading = 'eager' } = Astro.props;
---

<Picture
  src={white}
  alt=""
  widths={[160, 256, 384, 512]}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  class={className}
  loading={loading}
  decoding="async"
/>
