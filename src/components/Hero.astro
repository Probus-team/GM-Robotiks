---
// Inset rounded video frame. The montage is Pudu Robotics' own footage; the
// caption under it names the robot and the setting of each shot, and links to
// that robot's page. The poster is a responsive <picture>; the video only
// downloads after the page has loaded, and never with reduced motion or
// data saver on.
import Visor from './Visor.astro';
import Icon from './Icon.astro';
import { families, robots } from '../data/robots';

// Seconds where each shot starts in public/media/hero/montage-*.mp4 (10.5 s).
const shots = [
  { at: 0, robot: 'et1', label: 'ET1', where: 'fregado en tienda' },
  { at: 1.47, robot: 't300', label: 'T300', where: 'abasto de línea en manufactura' },
  { at: 4.47, robot: 'gt5', label: 'GT5', where: 'corte de áreas verdes' },
  { at: 6.47, robot: 'gt7', label: 'GT7', where: 'corte helicoidal en campo' },
  { at: 8.4, robot: 'et1', label: 'ET1', where: 'limpieza de recepción' },
];

const counts = families.map((f) => ({
  ...f,
  count: robots.filter((r) => r.family === f.id).length,
}));
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="frame hero-frame on-dark">
    <div class="media" aria-hidden="true">
      <picture>
        <source media="(max-aspect-ratio: 4/5)" srcset="/media/hero/montage-poster-540.webp" width="540" height="960" />
        <img class="poster" src="/media/hero/montage-poster-1600.webp" alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
      </picture>
      <video
        class="video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        data-hero-video
        data-src-portrait="/media/hero/montage-540.mp4"
        data-src-medium="/media/hero/montage-1280.mp4"
        data-src-large="/media/hero/montage-1600.mp4"
      ></video>
    </div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="container content">
      <p class="eyebrow intro" style="--i:0">Distribuidor Pudu Robotics · México</p>
      <h1 id="hero-title">
        <span class="mask"><span class="word" style="--i:1">Robots</span></span>
        <span class="mask"><span class="word" style="--i:2">que ya</span></span>
        <span class="mask"><span class="word line" style="--i:3">trabajan<Visor class="visor-inline" />.</span></span>
      </h1>
      <p class="lede intro" style="--i:4">
        Limpieza, entrega, logística y áreas verdes con robots Pudu. Los probamos en tu operación antes de que
        los compres, y les damos soporte desde México.
      </p>
      <div class="cta intro" style="--i:5">
        <a href="/robots/" class="btn btn-white">Ver los robots <Icon name="arrow" /></a>
        <a href="#ahorro" class="btn btn-ghost-light">Calcula tu ahorro</a>
      </div>
    </div>

    <div class="reel intro" style="--i:6" data-reel>
      <ol class="ticks" aria-hidden="true">
        {shots.map((s, i) => <li style={`--n:${i}`} class:list={{ 'is-current': i === 0 }} data-tick></li>)}
      </ol>
      <a class="caption" href={`/robots/${shots[0].robot}/`} data-caption>
        <b data-caption-label>{shots[0].label}</b>{' '}
        <span data-caption-where>{shots[0].where}</span>
      </a>
      <span class="credit">Video: Pudu Robotics</span>
      <button class="pause" type="button" aria-pressed="false" data-hero-toggle hidden>
        <span class="i-pause"><Icon name="pause" /></span>
        <span class="i-play"><Icon name="play" /></span>
        <span class="sr-only" data-toggle-label>Pausar video</span>
      </button>
    </div>
  </div>

  <nav class="container index" aria-label="Elige una línea">
    <ul>
      {counts.map((f) => (
        <li>
          <a href={`/robots/#${f.id}`}>
            <span class="idx-name">{f.name}</span>
            <span class="idx-short">{f.short}</span>
            <span class="idx-count">{f.count} {f.count === 1 ? 'modelo' : 'modelos'} <Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <script type="application/json" data-shots set:html={JSON.stringify(shots)} />
</section>

<style>
  .hero {
    padding-top: var(--bezel);
  }

  .hero-frame {
    display: grid;
    align-items: end;
    min-height: 36rem;
    height: calc(100svh - 2 * var(--bezel));
    max-height: 62rem;
    background: var(--ink);
  }

  .media,
  .scrim {
    position: absolute;
    inset: 0;
  }

  .media {
    z-index: 0;
  }

  .poster,
  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .video.is-playing {
    opacity: 1;
  }

  /* Navy wash from the lower left, where the type sits; the footage stays
     legible on the right. */
  .scrim {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(10, 28, 43, 0.82) 0%, rgba(10, 28, 43, 0.5) 45%, rgba(10, 28, 43, 0.05) 75%),
      linear-gradient(0deg, rgba(10, 28, 43, 0.85) 0%, rgba(10, 28, 43, 0) 55%),
      linear-gradient(180deg, rgba(10, 28, 43, 0.55) 0%, rgba(10, 28, 43, 0) 22%);
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.1rem, 2vw, 1.6rem);
    justify-items: start;
    padding-bottom: clamp(5.5rem, 12vh, 8.5rem);
  }

  h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
    text-shadow: 0 2px 40px rgba(10, 28, 43, 0.35);
  }

  /* Load sequence: each line rises out of its own mask, then the rest fades in. */
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }

  .word {
    display: block;
    animation: rise-word 1s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.11s);
  }

  h1 .line {
    white-space: nowrap;
  }

  .intro {
    animation: fade-up 0.9s var(--ease-out) both;
    animation-delay: calc(0.25s + var(--i) * 0.1s);
  }

  @keyframes rise-word {
    from {
      transform: translateY(110%) rotate(2deg);
    }
    to {
      transform: none;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  :global(.visor-inline) {
    --w: 0.78em;
    margin-left: 0.12em;
  }

  .lede {
    max-width: 31em;
    color: rgba(226, 238, 248, 0.88);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Shot caption, credit and pause, in the lower right of the frame. */
  .reel {
    position: absolute;
    z-index: 3;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.4rem 0.9rem;
    justify-items: end;
    max-width: calc(100% - 2rem);
  }

  .ticks {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ticks li {
    width: 1.6rem;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.28);
    transition: background-color 0.3s;
  }

  .ticks li.is-current {
    background: var(--white);
  }

  .caption {
    display: inline-flex;
    gap: 0.45rem;
    align-items: baseline;
    text-decoration: none;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.9);
  }

  .caption b {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--white);
  }

  .caption:hover span {
    text-decoration: underline;
  }

  .credit {
    grid-column: 1 / -1;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.66);
  }

  .pause {
    grid-row: 2;
    grid-column: 2;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(10, 28, 43, 0.4);
    color: var(--white);
    cursor: pointer;
  }

  .pause:hover {
    background: rgba(10, 28, 43, 0.7);
  }

  .pause .i-play,
  .pause[aria-pressed='true'] .i-pause {
    display: none;
  }

  .pause[aria-pressed='true'] .i-play {
    display: inline-flex;
  }

  /* Line index under the frame */
  .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .index a {
    display: grid;
    gap: 0.3rem;
    padding: 1.6rem 1.25rem 1.8rem;
    text-decoration: none;
    border-left: 1px solid var(--line);
    height: 100%;
    transition: background-color 0.2s;
  }

  .index li:first-child a {
    border-left: 0;
    padding-left: 0;
  }

  .idx-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    color: var(--navy);
  }

  .idx-short {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .idx-count {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.3rem;
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--blue);
  }

  .index a:hover .idx-count :global(.arrow) {
    translate: 0.25rem 0;
  }

  .index :global(.arrow) {
    transition: translate 0.35s var(--ease-out);
  }

  @media (max-width: 64rem) {
    .index ul {
      grid-template-columns: repeat(2, 1fr);
    }

    .index li:nth-child(odd) a {
      border-left: 0;
      padding-left: 0;
    }

    .index li:nth-child(n + 3) a {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 40rem) {
    .hero-frame {
      min-height: 40rem;
      height: calc(100svh - 2 * var(--bezel));
    }

    .scrim {
      background:
        linear-gradient(0deg, rgba(10, 28, 43, 0.95) 0%, rgba(10, 28, 43, 0.75) 45%, rgba(10, 28, 43, 0.1) 75%),
        linear-gradient(180deg, rgba(10, 28, 43, 0.5) 0%, rgba(10, 28, 43, 0) 20%);
    }

    .content {
      padding-bottom: 6.5rem;
    }

    .content .eyebrow {
      letter-spacing: 0.08em;
    }

    .content .eyebrow::before {
      display: none;
    }

    .cta .btn {
      flex: 1 1 auto;
    }

    .reel {
      left: var(--gutter);
      right: var(--gutter);
      justify-items: start;
      grid-template-columns: 1fr auto;
    }

    .index a {
      padding: 1.2rem 0.9rem 1.3rem;
    }

    .idx-name {
      font-size: 1.15rem;
    }

    .idx-short {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .intro {
      animation: none;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-toggle-label]');
  const caption = document.querySelector<HTMLAnchorElement>('[data-caption]');
  const captionLabel = document.querySelector<HTMLElement>('[data-caption-label]');
  const captionWhere = document.querySelector<HTMLElement>('[data-caption-where]');
  const ticks = Array.from(document.querySelectorAll<HTMLElement>('[data-tick]'));
  const shots: { at: number; robot: string; label: string; where: string }[] = JSON.parse(
    document.querySelector('[data-shots]')?.textContent ?? '[]',
  );

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  const pickSource = (v: HTMLVideoElement) => {
    if (window.matchMedia('(max-aspect-ratio: 4/5)').matches) return v.dataset.srcPortrait;
    return window.innerWidth * Math.min(window.devicePixelRatio, 2) <= 1400 ? v.dataset.srcMedium : v.dataset.srcLarge;
  };

  let shot = 0;
  const showShot = (i: number) => {
    if (i === shot || !shots[i]) return;
    shot = i;
    ticks.forEach((tick, n) => tick.classList.toggle('is-current', n === i));
    if (caption) caption.href = `/robots/${shots[i].robot}/`;
    if (captionLabel) captionLabel.textContent = shots[i].label;
    if (captionWhere) captionWhere.textContent = shots[i].where;
  };

  const setPaused = (paused: boolean) => {
    toggle?.setAttribute('aria-pressed', String(paused));
    if (toggleLabel) toggleLabel.textContent = paused ? 'Reproducir video' : 'Pausar video';
  };

  const start = () => {
    if (!video || video.src) return;
    const src = pickSource(video);
    if (!src) return;
    video.src = src;
    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.addEventListener('timeupdate', () => {
      let i = 0;
      shots.forEach((s, n) => {
        if (video.currentTime >= s.at) i = n;
      });
      showShot(i);
    });
    video.play().then(() => {
      if (toggle) toggle.hidden = false;
    }).catch(() => {});
  };

  toggle?.addEventListener('click', () => {
    if (!video) return;
    if (video.paused) {
      video.play().catch(() => {});
      setPaused(false);
    } else {
      video.pause();
      setPaused(true);
    }
  });

  // Pause off screen and in background tabs; resume only if the visitor did not pause it.
  if (video && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      if (!video.src || toggle?.getAttribute('aria-pressed') === 'true') return;
      if (entry.isIntersecting && !document.hidden) video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  }

  if (video && !reduce && !saveData) {
    if (document.readyState === 'complete') setTimeout(start, 200);
    else window.addEventListener('load', () => setTimeout(start, 200), { once: true });
  }
</script>
