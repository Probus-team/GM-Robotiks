---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Catalog from '../components/Catalog.astro';
import Docs from '../components/Docs.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { robots } from '../data/robots';
const catalogUrl = new URL('/robots/', Astro.site).href;
const structuredData = [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Catálogo de robots Pudu', item: catalogUrl },
  ] },
  { '@type': 'ItemList', '@id': `${catalogUrl}#catalog`, name: 'Catálogo de robots Pudu',
    numberOfItems: robots.length, itemListElement: robots.map((robot, index) => ({
      '@type': 'ListItem', position: index + 1, name: robot.name,
      description: robot.summary, url: `${catalogUrl}#${robot.id}`,
    })) },
];
---

<Layout
  title={`Catálogo de robots Pudu · ${site.name}`}
  description={`Los ${robots.length} robots Pudu de limpieza, entrega, logística y exteriores que GM Robotiks IA integra en México, con especificaciones del fabricante y fichas técnicas.`}
  structuredData={structuredData}
>
  <Header solid />
  <main>
    <Catalog />
    <Docs />
    <Contact />
  </main>
  <Footer />
</Layout>
