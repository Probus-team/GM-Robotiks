---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Lineup from '../components/Lineup.astro';
import Savings from '../components/Savings.astro';
import Proof from '../components/Proof.astro';
import Process from '../components/Process.astro';
import Fleet from '../components/Fleet.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <link slot="head" rel="preload" as="image" href="/media/hero/montage-poster-1600.webp" media="(min-aspect-ratio: 4/5)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/media/hero/montage-poster-540.webp" media="(max-aspect-ratio: 4/5)" fetchpriority="high" />
  <Header />
  <main id="contenido">
    <Hero />
    <Showcase />
    <Lineup />
    <Savings />
    <Proof />
    <Process />
    <Fleet />
    <Contact />
  </main>
  <Footer />
</Layout>
