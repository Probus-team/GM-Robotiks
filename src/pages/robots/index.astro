---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Catalog from '../../components/Catalog.astro';
import Docs from '../../components/Docs.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { robots } from '../../data/robots';
import { breadcrumbs, robotPath } from '../../data/seo';
import { getImage } from 'astro:assets';
import { scene } from '../../lib/media';

// The hero image, preloaded at the top of <head> so it is requested ahead of the
// fonts and the inline CSS. Same widths and format as its <Picture> in
// Catalog.astro, so the URLs match (tests/catalog.test.mjs checks it).
const hero = await getImage({ src: scene('pudu-family'), widths: [640, 960, 1280, 1800, 2400], format: 'avif' });

const catalogUrl = new URL('/robots/', Astro.site).href;
const structuredData = [
  breadcrumbs(Astro.site!, [['Inicio', '/'], ['Catálogo de robots Pudu', '/robots/']]),
  { '@type': 'ItemList', '@id': `${catalogUrl}#catalog`, name: 'Catálogo de robots Pudu',
    numberOfItems: robots.length, itemListElement: robots.map((robot, index) => ({
      '@type': 'ListItem', position: index + 1, name: robot.name,
      url: new URL(robotPath(robot.id), Astro.site).href,
    })) },
];
---

<Layout
  title={`Catálogo de robots Pudu · ${site.name}`}
  description={`Los ${robots.length} robots Pudu de limpieza, entrega, logística y exteriores que GM Robotiks IA integra en México, con especificaciones del fabricante y fichas técnicas.`}
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <link slot="head-first" rel="preload" as="image" type="image/avif" imagesrcset={hero.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
  <Header />
  <main id="contenido">
    <Catalog />
    <Docs />
    <Contact />
  </main>
  <Footer />
</Layout>
