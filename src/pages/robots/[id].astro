---
// One page per robot. Numbers, specs and media are Pudu Robotics'; the page
// says so wherever they appear. "Cotizar" opens WhatsApp with the message
// already written for this robot.
import { Picture, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { cases, families, robots, type Robot } from '../../data/robots';
import { robotPath, robotTitle } from '../../data/seo';
import { robotCutout, robotScene } from '../../lib/media';
import { robotQuoteUrl } from '../../lib/whatsapp';
import { midSentence } from '../../lib/text';

export function getStaticPaths() {
  return robots.map((robot) => ({ params: { id: robot.id }, props: { robot } }));
}

interface Props {
  robot: Robot;
}

const { robot } = Astro.props;
const family = families.find((f) => f.id === robot.family)!;
const pageUrl = new URL(robotPath(robot.id), Astro.site).href;
const quoteUrl = robotQuoteUrl(site.contact.whatsapp, robot, pageUrl);
const cutout = robotCutout(robot.id);
const sceneImage = robotScene(robot.id);
const clip = cases.find((c) => c.id === robot.caseId);
const related = robots.filter((r) => r.family === robot.family && r.id !== robot.id).slice(0, 4);
const [maker, ...modelParts] = robot.name.startsWith('PUDU ') ? robot.name.split(' ') : ['', robot.name];
const model = modelParts.join(' ');

const productImages = await Promise.all(
  [cutout, sceneImage].filter(Boolean).map((src) => getImage({ src: src!, width: 1200, format: 'webp' })),
);
const description = `${robot.name}: ${midSentence(robot.role)}. ${robot.summary}`;
const structuredData = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Catálogo de robots Pudu', item: new URL('/robots/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: robot.name, item: pageUrl },
    ],
  },
  {
    '@type': 'Product',
    '@id': `${pageUrl}#product`,
    name: robot.name,
    description: robot.summary,
    url: pageUrl,
    image: productImages.map((image) => new URL(image.src, Astro.site).href),
    category: `Robots de ${family.name.toLowerCase()}`,
    brand: { '@type': 'Brand', name: 'Pudu Robotics' },
    manufacturer: { '@type': 'Organization', name: 'Pudu Robotics', url: 'https://www.pudurobotics.com' },
    additionalProperty: robot.specs.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  },
];
---

<Layout
  title={robotTitle(robot)}
  description={description.length > 158 ? `${description.slice(0, 155).replace(/\s+\S*$/, '')}…` : description}
  pageType="ItemPage"
  structuredData={structuredData}
  socialImage={`/og/${robot.id}.jpg`}
  socialImageAlt={`${robot.name}, ${midSentence(robot.role)}`}
>
  <Header />
  <main id="contenido">
    <section class="hero" aria-labelledby="robot-title">
      <div class="frame on-dark hero-frame" data-robot-hero>
        <div class="container hero-grid">
          <div class="copy">
            <nav class="crumbs" aria-label="Ruta">
              <a href="/robots/">Catálogo</a>
              <span aria-hidden="true">/</span>
              <a href={`/robots/#${family.id}`}>{family.name}</a>
            </nav>
            <h1 id="robot-title">
              {maker && <span class="maker">{maker}</span>}{' '}
              <span class="model">{model}</span>
            </h1>
            <p class="role">{robot.role}{robot.isNew && <span class="tag">Nuevo 2026</span>}</p>
            <p class="summary">{robot.summary}</p>
            <div class="cta">
              <a class="btn btn-white" href={quoteUrl} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Cotizar por WhatsApp
              </a>
              {robot.doc ? (
                <a class="btn btn-ghost-light" href={robot.doc} target="_blank" rel="noopener">
                  <Icon name="download" /> Ficha técnica (PDF)
                </a>
              ) : (
                <a class="btn btn-ghost-light" href={site.cta.href}>{site.cta.label}</a>
              )}
            </div>
          </div>
          <div class="stage">
            <Picture
              src={cutout}
              alt={`${robot.name}, ${midSentence(robot.role)}`}
              widths={[320, 480, 640, 800, 1000, 1200]}
              sizes="(max-width: 56rem) 80vw, 42vw"
              formats={['avif']}
              fallbackFormat="webp"
              loading="eager"
              fetchpriority="high"
              class="cutout"
            />
            <span class="floor" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="figures container" aria-label="Datos clave">
      <ul data-stagger>
        {robot.keyFigures.map((figure) => (
          <li class="reveal">
            <span class:list={['value', 'tabular', { long: figure.value.length + (figure.unit?.length ?? 0) > 7 }]}>{figure.value}{figure.unit && <span class="unit">{figure.unit}</span>}</span>
            <span class="label">{figure.label}</span>
          </li>
        ))}
      </ul>
      <p class="source">Datos del fabricante, Pudu Robotics. En el piloto los medimos en tu operación.</p>
    </section>

    <section class="section uses" aria-labelledby="uses-title">
      <div class:list={['container', 'uses-grid', { 'has-scene': sceneImage }]}>
        {sceneImage && (
          <figure class="scene">
            <div class="reveal-frame">
              <Picture
              src={sceneImage}
              alt={`${robot.name} en contexto`}
              widths={[480, 720, 960, 1280, 1600]}
              sizes="(max-width: 56rem) 100vw, 55vw"
              formats={['avif']}
              fallbackFormat="webp"
              loading="lazy"
              />
            </div>
            <figcaption>Imagen: Pudu Robotics</figcaption>
          </figure>
        )}
        <div class="uses-text">
          <p class="eyebrow">Dónde trabaja</p>
          <h2 id="uses-title">Para qué lo piden.</h2>
          <ul class="use-list" data-stagger>
            {robot.useCases.map((use) => (
              <li class="reveal">
                <h3>{use.title}</h3>
                <p>{use.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {clip && (
      <section class="clip-section" aria-labelledby="clip-title">
        <div class="container clip-grid">
          <div class="clip-text">
            <p class="eyebrow">{clip.kind === 'deployment' ? 'En sitio del cliente' : 'Video de producto'}</p>
            <h2 id="clip-title">{clip.title}</h2>
            <p class="lede">{clip.where} · Pudu Robotics · {clip.minutes} min</p>
          </div>
          <div class="video-frame reveal-frame">
            <video src={clip.src} data-poster={clip.poster} preload="none" controls playsinline aria-label={`${clip.title}. ${clip.where}.`} data-clip></video>
          </div>
        </div>
      </section>
    )}

    <section class="section specs" aria-labelledby="specs-title">
      <div class="container specs-grid">
        <div>
          <p class="eyebrow">Especificaciones</p>
          <h2 id="specs-title">{robot.name}, en números.</h2>
          <p class="note">Fuente: fichas y páginas oficiales de Pudu Robotics. Pueden cambiar sin previo aviso.</p>
          {robot.doc && (
            <a class="link-arrow" href={robot.doc} target="_blank" rel="noopener"><Icon name="download" /> Descargar ficha técnica (PDF)</a>
          )}
        </div>
        <dl>
          {robot.specs.map(([name, value]) => (
            <div>
              <dt>{name}</dt>
              <dd class="tabular">{value}</dd>
            </div>
          ))}
          <div>
            <dt>Línea</dt>
            <dd>{family.name}</dd>
          </div>
          <div>
            <dt>Soporte y refacciones</dt>
            <dd>GM Robotiks IA, México</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="frame on-dark closing-frame">
        <div class="container closing-grid">
          <div>
            <h2 id="closing-title">Pruébalo en tu operación.</h2>
            <p class="lede">
              Hacemos el diagnóstico en sitio y, si conviene, un piloto medido con el {robot.name}. Si no es el
              robot correcto, te lo decimos.
            </p>
          </div>
          <div class="closing-cta">
            <a class="btn btn-white" href={quoteUrl} target="_blank" rel="noopener"><Icon name="whatsapp" /> Cotizar por WhatsApp</a>
            <a class="link-arrow" href="/#proceso">Cómo trabajamos <Icon name="arrow" /></a>
          </div>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section related" aria-labelledby="related-title">
        <div class="container">
          <h2 id="related-title">Otros robots de {family.name.toLowerCase()}</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={robotPath(r.id)}>
                  <span class="r-stage">
                    <Picture src={robotCutout(r.id)} alt="" widths={[200, 320, 480]} sizes="(max-width: 40rem) 40vw, 14rem" formats={['avif']} fallbackFormat="webp" loading="lazy" />
                  </span>
                  <span class="r-name">{r.name}</span>
                  <span class="r-role">{r.role}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow" href="/robots/">Ver los {robots.length} robots <Icon name="arrow" /></a>
        </div>
      </section>
    )}
  </main>

  <div class="sticky-cta" data-sticky-cta inert>
    <a class="btn btn-navy" href={quoteUrl} target="_blank" rel="noopener" tabindex="-1">
      <Icon name="whatsapp" /> Cotizar {robot.name.replace('PUDU ', '')} por WhatsApp
    </a>
  </div>
  <Footer />
</Layout>

<style>
  .hero {
    padding-top: var(--bezel);
  }

  .hero-frame {
    background:
      radial-gradient(40rem 30rem at 72% 78%, rgba(42, 140, 255, 0.3), transparent 65%),
      linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 55%, var(--ink) 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    min-height: min(52rem, calc(100svh - 2 * var(--bezel)));
    padding-top: 7.5rem;
  }

  .copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
  }

  .crumbs a {
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  h1 {
    display: grid;
    line-height: 0.88;
  }

  .maker {
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--sky);
    margin-bottom: 0.4em;
  }

  .model {
    font-size: clamp(3.4rem, 9vw, 8.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.15;
  }

  .tag {
    padding: 0.25rem 0.55rem;
    border-radius: 0.45rem;
    background: var(--white);
    color: var(--navy);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .summary {
    max-width: 32em;
    color: var(--on-dark-muted);
    font-size: 1.08rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: end center;
    height: 100%;
    max-height: 44rem;
    padding-bottom: 3rem;
  }

  .stage :global(.cutout) {
    position: relative;
    z-index: 1;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(36rem, 62svh);
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
    animation: arrive 1.1s var(--ease-out) 0.15s both;
  }

  .floor {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 3rem;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--sky) 25%, var(--sky) 75%, transparent);
  }

  .floor::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    top: -2.5rem;
    height: 5rem;
    background: radial-gradient(closest-side, rgba(111, 178, 234, 0.35), transparent);
    filter: blur(8px);
  }

  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 30px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Three big numbers */
  .figures {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
  }

  .figures ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .figures li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 0 1.5rem;
    border-left: 1px solid var(--line);
  }

  .figures li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-figure);
    letter-spacing: -0.045em;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--navy);
  }

  /* Ranges like 1,500–3,000 m²/h stay on one line. */
  .value.long {
    font-size: clamp(2rem, 2.9vw + 0.5rem, 3.6rem);
  }

  .unit {
    font-size: 0.42em;
    letter-spacing: -0.01em;
    margin-left: 0.2em;
    color: var(--blue);
  }

  .label {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 16em;
  }

  .source {
    margin-top: 2rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* Use cases */
  .uses-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .uses-grid.has-scene {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  }

  .scene {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .scene :global(img) {
    width: 100%;
    max-height: 40rem;
    object-fit: cover;
    border-radius: var(--frame-radius);
  }

  .scene figcaption {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .uses-text {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .uses-text h2,
  .specs h2,
  .clip-text h2,
  .related h2 {
    color: var(--navy);
  }

  .use-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .use-list li {
    display: grid;
    gap: 0.3rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--blue);
  }

  .use-list h3 {
    font-size: 1.3rem;
    color: var(--navy);
  }

  .use-list p {
    color: var(--muted);
  }

  /* Video */
  .clip-section {
    padding-bottom: var(--section);
  }

  .clip-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .clip-text {
    display: grid;
    gap: 1rem;
  }

  .video-frame {
    border-radius: var(--frame-radius);
    overflow: hidden;
    background: var(--ink);
    aspect-ratio: 16 / 9;
  }

  .video-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Specs */
  .specs {
    background: var(--ice);
    /* The default blue is 4.4:1 on ice; this one passes for small text. */
    --accent: #1f6aa6;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .specs-grid > div {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .note {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  dl {
    margin: 0;
    display: grid;
    border-top: 2px solid var(--navy);
  }

  dl div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line-strong);
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-weight: 700;
    color: var(--navy);
  }

  /* Closing */
  .closing {
    padding-block: var(--bezel);
  }

  .closing-frame {
    background:
      radial-gradient(40rem 26rem at 100% 100%, rgba(42, 140, 255, 0.25), transparent 60%),
      linear-gradient(160deg, var(--navy), var(--ink));
  }

  .closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .closing-grid > div:first-child {
    display: grid;
    gap: 1rem;
  }

  .closing-cta {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  /* Related */
  .related h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin-bottom: 2rem;
  }

  .related ul {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1.5rem;
  }

  .related a:not(.link-arrow) {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
  }

  .r-stage {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: end center;
    aspect-ratio: 1;
    padding: 1.25rem 1rem 0;
    margin-bottom: 0.6rem;
    border-radius: var(--radius);
    background:
      linear-gradient(0deg, var(--ice-2) 0 14%, transparent 14%),
      var(--ice);
  }

  .r-stage :global(img) {
    max-height: 88%;
    width: auto;
    height: auto;
    margin-bottom: 8%;
    object-fit: contain;
    transition: translate 0.5s var(--ease-out);
  }

  .related a:hover .r-stage :global(img) {
    translate: 0 -6px;
  }

  .r-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--navy);
  }

  .r-role {
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Phones: a quote bar once the hero has scrolled away. */
  .sticky-cta {
    display: none;
  }

  @media (max-width: 40rem) {
    .sticky-cta {
      position: fixed;
      z-index: 50;
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      display: block;
      translate: 0 calc(100% + 1rem);
      transition: translate 0.35s var(--ease-out);
    }

    .sticky-cta.is-shown {
      translate: 0 0;
    }

    .sticky-cta .btn {
      width: 100%;
      box-shadow: 0 16px 30px -12px rgba(10, 28, 43, 0.6);
    }
  }

  @media (max-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 7rem;
    }

    .copy {
      padding-bottom: 0;
    }

    .stage {
      order: -1;
      height: auto;
      padding-bottom: 2rem;
    }

    .stage :global(.cutout) {
      max-height: 22rem;
    }

    .floor {
      bottom: 2rem;
    }

    .copy {
      padding-bottom: 2.5rem;
    }

    .uses-grid.has-scene,
    .clip-grid,
    .specs-grid,
    .closing-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .figures ul {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .figures li {
      padding: 0 0 1.5rem;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }

    .stage :global(.cutout) {
      max-height: 17rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage :global(.cutout) {
      animation: none;
    }
  }
</style>

<script>
  // The clip's poster loads as its section approaches, not with the page.
  const clipVideo = document.querySelector<HTMLVideoElement>('[data-clip]');
  if (clipVideo) {
    const showPoster = () => {
      if (clipVideo.dataset.poster) clipVideo.poster = clipVideo.dataset.poster;
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        showPoster();
        io.disconnect();
      }, { rootMargin: '600px 0px' });
      io.observe(clipVideo);
    } else {
      showPoster();
    }
  }

  // Show the phone quote bar once the hero is out of view.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('[data-robot-hero]');
  const link = bar?.querySelector('a');
  if (bar && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      bar.classList.toggle('is-shown', show);
      link?.setAttribute('tabindex', show ? '0' : '-1');
      bar.toggleAttribute('inert', !show);
    }).observe(hero);
  }
</script>
